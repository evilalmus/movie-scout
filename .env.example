# Backend credentials only. Never copy these into frontend config.js or GitHub variables.
TMDB_TOKEN=
OMDB_API_KEY=
# Prefer a bearer token; alternatively supply both email and password.
SAFESTREAM_TOKEN=
SAFESTREAM_EMAIL=
SAFESTREAM_PASSWORD=
SAFESTREAM_DEBUG=false
SAFESTREAM_MONTHLY_LIMIT=1000
SAFESTREAM_USER_RESERVE=300
# Optional alternative feed (must supply scaleMax: 10).
GUIDANCE_FEED_URL=
GUIDANCE_FEED_TOKEN=
# Optional token for manual POST /api/daily. The internal scheduler needs no token.
JOB_TOKEN=

PORT=4174
HOST=0.0.0.0
DATA_DIR=./data
TZ=America/Los_Angeles
DAILY_ENABLED=true
DAILY_TIME=06:00

# Origins only, no path or trailing slash. For GitHub repo Pages use https://USERNAME.github.io.
# Add the real domain (and local Unraid URL if using the optional frontend).
ALLOWED_ORIGINS=https://movie-scout.g33k.bar,http://localhost:5173,http://localhost:8087
ENABLE_PUBLIC_IMPORTS=true
TRUST_PROXY=false
READS_PER_MINUTE=120
IMPORTS_PER_MINUTE=10
GLOBAL_REQUESTS_PER_MINUTE=300
TMDB_DAILY_LIMIT=2000
OMDB_DAILY_LIMIT=900
GUIDANCE_DAILY_LIMIT=2000

# Docker Compose settings.
MOVIE_SCOUT_DATA_DIR=/mnt/user/appdata/movie-scout
API_BIND_ADDRESS=0.0.0.0
API_PORT=4174
FRONTEND_PORT=8087

# Direct Rotten Tomatoes score collection (same Node container).
RT_ENABLED=false
RT_DEBUG=false
RT_DAILY_LIMIT=100

# Kids-in-Mind: optional, slow background guidance collection in this container.
KIM_ENABLED=false
# Identify your instance with a real contact email or website (required when enabled).
KIM_CONTACT=
# Hard maximum 10 requests/day, including robots, homepage, searches, reviews.
KIM_DAILY_LIMIT=10
# Minimum 60 seconds; default 120. Longer robots Crawl-delay takes precedence.
KIM_INTERVAL_SECONDS=120
